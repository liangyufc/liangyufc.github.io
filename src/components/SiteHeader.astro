---
interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const sectionLink = (section: string) => `${home ? '' : '/'}#${section}`;
---
<header class="site-header">
  <a class="wordmark" href={sectionLink('top')} aria-label="Liang, back to top">lng<span aria-hidden="true">.</span></a>
  <nav aria-label="Main navigation">
    <a href={sectionLink('about')}>About</a>
    <a href={sectionLink('projects')}>Projects</a>
    <a href={sectionLink('contact')}>Contact</a>
  </nav>
</header>
